---
import Base from '../../layouts/Base.astro';
import Wafer from '../../components/Wafer.astro';
import StatusGlyph from '../../components/StatusGlyph.astro';
import { LOCALES, LOCALE_META } from '../../lib/locale.mjs';
import { fill, getDict } from '../../lib/i18n.mjs';
import { apps, formatDate, listedCount, nvidiaApps, otherIndexCount, statusCounts, usedCategories } from '../../lib/data.mjs';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const t = getDict(locale);
const base = import.meta.env.BASE_URL;
const home = `${base}${locale}/`;
const statuses = ['native', 'prism', 'broken'];
const PER_PAGE = 50;
const messages = {
  count: t.list.count,
  none: t.list.none,
  range: t.list.range,
  pageN: t.list.pageN,
  moreTitle: t.more.title,
  moreLoading: t.more.loading,
  moreError: t.more.error,
};
const indexTotal = otherIndexCount.toLocaleString('en');
// NVIDIA's rows are drawn a page at a time from this, which keeps the page small.
const nvRows = JSON.stringify(
  nvidiaApps.map((e) => [e.name, e.publisher ?? '', e.status, e.version ?? '', e.checked ?? '', e.url, e.category]),
).replaceAll('<', '\\u003c');
---
<Base locale={locale} active="list">
  <section class="wrap hero">
    <div class="hero-copy">
      <h1>{t.hero.title}</h1>
      <div class="search">
        <label class="visually-hidden" for="q">{t.hero.search}</label>
        <input id="q" type="search" placeholder={t.hero.search} autocomplete="off" />
        <p class="muted small search-note">{fill(t.more.searchNote, { n: indexTotal })}</p>
      </div>
      <fieldset class="tally">
        <legend class="visually-hidden">{t.list.filterStatus}</legend>
        <div class="bar" aria-hidden="true">
          {statuses.map((s) => <span class={`seg seg-${s}`} style={`flex-grow:${statusCounts[s]}`}></span>)}
        </div>
        {statuses.map((s) => (
          <label class="tally-option" data-status={s}>
            <input type="checkbox" name="status" value={s} />
            <span class="status" data-status={s}><StatusGlyph status={s} />{t.status[s]}</span>
            <span class="tally-num">{statusCounts[s].toLocaleString('en')}</span>
            <span class="tally-def muted small">{t.status[`${s}Def`]}</span>
          </label>
        ))}
      </fieldset>
      <p class="muted small broken-note">{t.list.brokenNote}</p>
    </div>
    <Wafer apps={apps} locale={locale} />
  </section>

  <section
    class="wrap catalog"
    id="catalog"
    data-messages={JSON.stringify(messages)}
    data-report={`${home}report/`}
    data-lang={LOCALE_META[locale].lang}
    data-per-page={PER_PAGE}
  >
    <div class="catalog-tools">
      <div class="cats" role="group" aria-label={t.list.category}>
        <button type="button" class="cat" data-cat="" aria-pressed="true">{t.list.all}</button>
        {usedCategories.map((c) => (
          <button type="button" class="cat" data-cat={c} aria-pressed="false">{t.categories[c]}</button>
        ))}
      </div>
      <p class="count muted small" id="count" aria-live="polite">{fill(t.list.count, { n: listedCount.toLocaleString('en') })}</p>
    </div>

    <div class="table" id="list" role="table" aria-label={t.nav.list}>
      <div class="head" role="row">
        <span role="columnheader">{t.list.software}</span>
        <span role="columnheader">{t.list.result}</span>
        <span role="columnheader">{t.list.version}</span>
        <span role="columnheader">{t.list.reports}</span>
        <span role="columnheader">{t.list.checked}</span>
      </div>
      {apps.map((app) => (
        <div
          class="row"
          role="row"
          data-id={app.id}
          data-status={app.status}
          data-cat={app.category}
          data-search={[app.name, app.vendor, ...(app.aliases ?? [])].join(' ').toLowerCase()}
        >
          <span class="name" role="cell">
            <span class="mono" aria-hidden="true" data-cat={app.category}>{app.name.slice(0, 1)}</span>
            <span class="name-text">
              <a class="row-link" href={`${home}apps/${app.id}/`}>{app.name}</a>
              <span class="muted small">{app.vendor}</span>
            </span>
          </span>
          <span class="result" role="cell">
            <span class="status" data-status={app.status}><StatusGlyph status={app.status} />{t.status[app.status]}</span>
            <span class="flags">
              {app.maturity && app.maturity !== 'stable' && <span class="tag">{t.maturity[app.maturity]}</span>}
              {app.caveats?.length > 0 && <span class="tag">{t.list.caveat}</span>}
            </span>
          </span>
          <span class="version small muted" role="cell">{app.version ?? ''}</span>
          <span class="reports small muted" role="cell">{app.reports.length || ''}</span>
          <span class="checked small muted" role="cell">{formatDate(app.verifiedAt, locale)}</span>
        </div>
      ))}
      <div id="nv-rows" class="rowgroup" role="rowgroup"></div>
    </div>
    <script type="application/json" id="nv-data" is:inline set:html={nvRows} />

    <nav class="pager" id="pager" aria-label={t.list.pages} hidden>
      <p class="pager-range muted small" id="pager-range"></p>
      <div class="pager-pages">
        <button type="button" class="cat pager-step" id="pager-prev">{t.list.prev}</button>
        <span class="pager-nums" id="pager-nums"></span>
        <button type="button" class="cat pager-step" id="pager-next">{t.list.next}</button>
      </div>
    </nav>
    <p class="muted small list-note">{t.nv.note}</p>

    <div class="more" id="more" data-src={`${base}api/software-index.json`}>
      <h2 class="more-title" id="more-title" aria-live="polite"></h2>
      <p class="muted small">{t.more.note}</p>
      <div class="table" id="more-rows" role="table" aria-labelledby="more-title" hidden></div>
      <button type="button" class="cat more-button" id="more-browse">{fill(t.more.browse, { n: indexTotal })}</button>
      <button type="button" class="cat more-button" id="more-next" hidden>{t.more.next}</button>
    </div>

    <template id="more-row">
      <div class="row" role="row">
        <span class="name" role="cell">
          <span class="mono" aria-hidden="true"></span>
          <span class="name-text">
            <a class="row-link" rel="noopener nofollow"></a>
            <span class="muted small publisher"></span>
          </span>
        </span>
        <span class="result" role="cell">
          {statuses.map((s) => (
            <span class="status" data-status={s}><StatusGlyph status={s} />{t.status[s]}</span>
          ))}
          <span class="flags"><span class="tag">{t.nv.tag}</span></span>
        </span>
        <span class="version small muted" role="cell"></span>
        <span class="reports small muted" role="cell"></span>
        <span class="checked small muted" role="cell"></span>
      </div>
    </template>

    <div class="empty" id="empty" hidden>
      <p id="empty-text"></p>
      <a class="button" id="empty-action" href={`${home}report/`}>{t.list.noneAction}</a>
    </div>
  </section>
</Base>

<script>
  const catalog = document.getElementById('catalog');
  const messages = JSON.parse(catalog.dataset.messages);
  const PER_PAGE = Number(catalog.dataset.perPage);
  const dateFormat = new Intl.DateTimeFormat(catalog.dataset.lang, { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
  const search = document.getElementById('q');
  const list = document.getElementById('list');
  const ownRows = [...list.querySelectorAll('.row[data-id]')];
  const nvBox = document.getElementById('nv-rows');
  const cats = [...catalog.querySelectorAll('.cats .cat')];
  const statusBoxes = [...document.querySelectorAll('input[name="status"]')];
  const count = document.getElementById('count');
  const empty = document.getElementById('empty');
  const emptyText = document.getElementById('empty-text');
  const emptyAction = document.getElementById('empty-action');
  const pager = document.getElementById('pager');
  const pagerRange = document.getElementById('pager-range');
  const pagerNums = document.getElementById('pager-nums');
  const pagerPrev = document.getElementById('pager-prev');
  const pagerNext = document.getElementById('pager-next');
  const wafer = document.querySelector('.wafer');
  const dies = new Map(
    [...document.querySelectorAll('[data-wafer-die]')].map((d) => [d.dataset.waferDie, d]),
  );
  const nvData = JSON.parse(document.getElementById('nv-data').textContent).map(
    ([name, publisher, status, version, checked, url, category]) => ({
      name, publisher, status, version, checked, url, category, nvidia: true,
      hay: `${name} ${publisher}`.toLowerCase(),
    }),
  );

  let cat = '';
  let page = 1;
  let pages = 1;

  // The rest of the index holds thousands of programs, so it loads only when someone needs it.
  const MORE_STEP = 50;
  const more = document.getElementById('more');
  const moreTitle = document.getElementById('more-title');
  const moreRows = document.getElementById('more-rows');
  const moreBrowse = document.getElementById('more-browse');
  const moreNext = document.getElementById('more-next');
  const rowTemplate = document.getElementById('more-row');
  let index = null;
  let indexFailed = false;
  let loading = null;
  let browsing = false;
  let limit = MORE_STEP;

  function loadIndex() {
    loading ??= fetch(more.dataset.src)
      .then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
      .then((body) => {
        // Programs NVIDIA verified are already in the list above.
        index = body.software.filter((e) => !e.nvidia).map((e) => ({ ...e, hay: `${e.name} ${e.publisher ?? ''}`.toLowerCase() }));
      })
      .catch(() => { indexFailed = true; loading = null; })
      .finally(() => apply({ syncUrl: false }));
    return loading;
  }

  const showDate = (iso) => (/^\d{4}-\d{2}-\d{2}$/.test(iso ?? '') ? dateFormat.format(new Date(`${iso}T00:00:00Z`)) : '');

  function buildRow(entry) {
    const row = rowTemplate.content.firstElementChild.cloneNode(true);
    row.dataset.status = entry.status;
    if (entry.category) row.dataset.cat = entry.category;
    row.querySelector('.mono').textContent = entry.name.slice(0, 1);
    const link = row.querySelector('.row-link');
    link.textContent = entry.name;
    if (entry.url.startsWith('https://')) link.href = entry.url;
    row.querySelector('.publisher').textContent = entry.publisher ?? '';
    row.querySelectorAll('.result > .status').forEach((s) => { if (s.dataset.status !== entry.status) s.remove(); });
    if (!entry.nvidia) row.querySelector('.flags').remove();
    row.querySelector('.version').textContent = entry.version ?? '';
    row.querySelector('.checked').textContent = showDate(entry.checked);
    return row;
  }

  /** Returns how many index entries match, or null while they are unknown. */
  function renderMore(q, wanted) {
    const relevant = !cat || cat === 'game';
    const active = relevant && (q.length >= 2 || browsing);
    moreBrowse.hidden = active || !relevant;
    more.hidden = !relevant;
    moreRows.hidden = true;
    moreNext.hidden = true;
    moreTitle.textContent = '';
    if (!active) return 0;
    if (indexFailed) { moreTitle.textContent = messages.moreError; indexFailed = false; return 0; }
    if (!index) { moreTitle.textContent = messages.moreLoading; loadIndex(); return null; }
    const found = index.filter((e) =>
      e.hay.includes(q) && (!wanted.length || wanted.includes(e.status)) && (cat !== 'game' || e.game));
    // Names that start with the search come first.
    if (q) {
      const rank = (e) => (e.name.toLowerCase().startsWith(q) ? 0 : 1);
      found.sort((a, b) => rank(a) - rank(b));
    }
    moreTitle.textContent = messages.moreTitle.replace('{n}', found.length.toLocaleString('en'));
    moreRows.replaceChildren(...found.slice(0, limit).map(buildRow));
    moreRows.hidden = found.length === 0;
    moreNext.hidden = found.length <= limit;
    return found.length;
  }

  moreBrowse.addEventListener('click', () => { browsing = true; apply({ syncUrl: false }); });
  moreNext.addEventListener('click', () => { limit += 100; apply({ syncUrl: false }); });

  /** Page numbers to offer: the ends, and the pages around the current one. */
  // Phones have room for the first, current and last page only.
  const narrow = matchMedia('(max-width: 479px)');
  function pageNumbers() {
    const wide = !narrow.matches;
    if (pages <= (wide ? 7 : 3)) return Array.from({ length: pages }, (_, i) => i + 1);
    const near = (wide ? [page - 1, page, page + 1] : [page]).filter((n) => n > 1 && n < pages);
    if (wide && page <= 3) near.push(2, 3, 4);
    if (wide && page >= pages - 2) near.push(pages - 3, pages - 2, pages - 1);
    const set = [...new Set([1, ...near, pages])].sort((a, b) => a - b);
    return set.flatMap((n, i) => (i && n - set[i - 1] > 1 ? [0, n] : [n]));
  }

  // Elements made here need the page's style scope to pick up its button styles.
  const scope = pagerPrev.getAttributeNames().filter((a) => a.startsWith('data-astro-cid'));
  const scoped = (tag) => {
    const el = document.createElement(tag);
    scope.forEach((a) => el.setAttribute(a, ''));
    return el;
  };

  function renderPager(from, to, total) {
    pager.hidden = pages <= 1;
    if (pager.hidden) return;
    pagerRange.textContent = messages.range
      .replace('{from}', (from + 1).toLocaleString('en'))
      .replace('{to}', to.toLocaleString('en'))
      .replace('{n}', total.toLocaleString('en'));
    pagerPrev.disabled = page === 1;
    pagerNext.disabled = page === pages;
    pagerNums.replaceChildren(...pageNumbers().map((n) => {
      if (!n) {
        const gap = scoped('span');
        gap.className = 'pager-gap';
        gap.textContent = '…';
        return gap;
      }
      const b = scoped('button');
      b.type = 'button';
      b.className = 'cat pager-num';
      b.textContent = String(n);
      b.dataset.page = String(n);
      b.setAttribute('aria-label', messages.pageN.replace('{n}', n));
      if (n === page) b.setAttribute('aria-current', 'page');
      return b;
    }));
  }

  function goTo(n) {
    page = n;
    apply();
    list.scrollIntoView({ block: 'start' });
  }
  pagerPrev.addEventListener('click', () => goTo(page - 1));
  pagerNext.addEventListener('click', () => goTo(page + 1));
  pagerNums.addEventListener('click', (e) => {
    const n = Number(e.target.closest('[data-page]')?.dataset.page);
    if (n) goTo(n);
  });

  function apply({ syncUrl = true } = {}) {
    const q = search.value.trim().toLowerCase();
    const wanted = statusBoxes.filter((b) => b.checked).map((b) => b.value);
    const keep = (status, category, hay) =>
      (!q || hay.includes(q)) && (!cat || category === cat) && (!wanted.length || wanted.includes(status));

    // This site's own entries come first, then NVIDIA's, split into pages.
    const ownMatch = ownRows.filter((r) => keep(r.dataset.status, r.dataset.cat, r.dataset.search));
    const nvMatch = nvData.filter((e) => keep(e.status, e.category, e.hay));
    const total = ownMatch.length + nvMatch.length;
    pages = Math.max(1, Math.ceil(total / PER_PAGE));
    page = Math.min(Math.max(1, page), pages);
    const from = (page - 1) * PER_PAGE;
    const to = Math.min(from + PER_PAGE, total);

    const matched = new Set(ownMatch);
    const onPage = new Set(ownMatch.slice(from, to));
    for (const row of ownRows) {
      row.hidden = !onPage.has(row);
      dies.get(row.dataset.id)?.classList.toggle('is-match', matched.has(row));
    }
    nvBox.replaceChildren(...nvMatch
      .slice(Math.max(0, from - ownMatch.length), Math.max(0, to - ownMatch.length))
      .map(buildRow));

    wafer.classList.toggle('wafer-filtered', Boolean(q || cat || wanted.length));
    // On phones the results would sit a full screen below the search box.
    document.querySelector('.hero').classList.toggle('is-searching', Boolean(q));
    count.textContent = messages.count.replace('{n}', total.toLocaleString('en'));
    renderPager(from, to, total);
    const inIndex = renderMore(q, wanted);
    // Stay quiet while the index loads, so "no results" does not flash before it arrives.
    const nothing = total === 0 && inIndex === 0;
    empty.hidden = !nothing;
    list.hidden = total === 0;
    if (nothing) {
      emptyText.textContent = messages.none.replace('{q}', search.value.trim());
      emptyAction.href = `${catalog.dataset.report}?software=${encodeURIComponent(search.value.trim())}`;
    }
    if (syncUrl) {
      const params = new URLSearchParams();
      if (q) params.set('q', search.value.trim());
      if (cat) params.set('cat', cat);
      if (wanted.length) params.set('status', wanted.join(','));
      if (page > 1) params.set('page', String(page));
      const qs = params.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }
  }

  function setCat(value) {
    cat = value;
    cats.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
  }

  const params = new URLSearchParams(location.search);
  if (params.get('q')) search.value = params.get('q');
  if (cats.some((b) => b.dataset.cat === params.get('cat'))) setCat(params.get('cat'));
  const fromUrl = (params.get('status') ?? '').split(',');
  statusBoxes.forEach((b) => { b.checked = fromUrl.includes(b.value); });
  page = Number.parseInt(params.get('page') ?? '1', 10) || 1;

  // A new search or filter starts again from the first page.
  search.addEventListener('input', () => { limit = MORE_STEP; page = 1; apply(); });
  statusBoxes.forEach((b) => b.addEventListener('change', () => { page = 1; apply(); }));
  cats.forEach((b) => b.addEventListener('click', () => { setCat(b.dataset.cat); page = 1; apply(); }));

  apply({ syncUrl: false });
</script>

<style>
  .hero {
    display: grid;
    gap: 32px;
    padding-block: clamp(32px, 6vw, 72px) clamp(32px, 5vw, 56px);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  .hero :global(.wafer) { width: min(100%, 440px); justify-self: center; }
  @media (min-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 420px); gap: 64px; }
    .hero :global(.wafer) { justify-self: end; }
  }
  @media (max-width: 899px) {
    .hero :global(.wafer) { width: min(70%, 300px); }
    .hero.is-searching :global(.wafer), .hero.is-searching .tally-def, .hero.is-searching .bar, .hero.is-searching .search-note, .hero.is-searching .broken-note { display: none; }
    .hero.is-searching { padding-bottom: 16px; gap: 0; }
    .hero.is-searching .tally-option { padding-block: 6px; }
  }
  .search { margin-top: 24px; }
  .search input {
    width: 100%; font: inherit; font-size: clamp(1.125rem, 1rem + 0.8vw, 1.5rem);
    padding: 14px 16px; min-height: 56px;
    background: var(--surface); color: var(--ink);
    border: 2px solid var(--ink); border-radius: var(--radius-control);
  }
  .search input::placeholder { color: var(--muted); }
  .search-note { margin-top: 8px; }
  .more { margin-top: 32px; display: grid; gap: 10px; justify-items: start; }
  .more[hidden], .table[hidden], .pager[hidden] { display: none; }
  .rowgroup { display: contents; }
  .broken-note { margin-top: 12px; max-width: 46ch; }
  .list-note { margin: 12px 0 0; max-width: 72ch; }

  .pager { margin-top: 16px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  .pager-range { margin: 0; }
  .pager-pages { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .pager-nums { display: contents; }
  .pager-num { min-width: 40px; font-variant-numeric: tabular-nums; }
  .pager-num[aria-current='page'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .pager-step:disabled { opacity: 0.4; cursor: default; }
  .pager-gap { padding-inline: 2px; color: var(--muted); }
  .more-title { font-size: 1.125rem; margin: 0; }
  .more-title:empty { display: none; }
  .more .table { width: 100%; }
  .more-button[hidden] { display: none; }

  .tally { border: 0; margin: 28px 0 0; padding: 0; }
  .bar { display: flex; height: 8px; gap: 2px; margin-bottom: 8px; }
  .seg { flex: 0 0 auto; flex-basis: 0; min-width: 4px; border-radius: 1px; }
  .seg-native { background: var(--die-native); }
  .seg-prism { background: var(--die-prism); }
  .seg-broken { background: var(--die-broken); }
  .tally-option {
    display: grid; grid-template-columns: 22px auto 1fr; gap: 0 8px; align-items: center;
    padding: 10px 0; border-bottom: 1px solid var(--rule); cursor: pointer;
  }
  .tally-option input { width: 18px; height: 18px; margin: 0; accent-color: var(--ink); }
  .tally-num { justify-self: end; font-family: var(--display); font-size: 1.375rem; font-weight: 700; line-height: 1; }
  .tally-def { grid-column: 2 / -1; margin-top: 2px; }

  .catalog { scroll-margin-top: 16px; }
  .catalog-tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .cats { display: flex; flex-wrap: wrap; gap: 6px; }
  .cat {
    font: inherit; font-size: 0.9375rem; color: var(--ink); background: transparent;
    border: 1px solid var(--rule); border-radius: var(--radius-control); padding: 6px 12px; min-height: 40px; cursor: pointer;
  }
  .cat:hover { border-color: var(--ink); }
  .cat[aria-pressed='true'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }

  .table { border-top: 2px solid var(--ink); }
  .head, .row {
    display: grid;
    grid-template-columns: minmax(0, 2.4fr) minmax(0, 1.8fr) minmax(0, 1fr) 64px 112px;
    gap: 16px; align-items: center;
  }
  .head { padding: 8px 4px; font-size: 0.8125rem; color: var(--muted); border-bottom: 1px solid var(--rule); }
  .row { position: relative; padding: 10px 4px; border-bottom: 1px solid var(--rule); }
  .row[hidden] { display: none; }
  .row:hover { background: var(--surface); }
  .row-link { color: var(--ink); font-weight: 600; text-decoration: none; }
  .row-link::after { content: ''; position: absolute; inset: 0; }
  .row:hover .row-link { text-decoration: underline; }
  .row-link:focus-visible { outline: none; }
  .row-link:focus-visible::after { outline: 3px solid var(--accent); outline-offset: -3px; }
  .name { display: flex; gap: 12px; align-items: center; min-width: 0; }
  .name-text { display: grid; min-width: 0; line-height: 1.35; }
  .mono {
    flex: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 5px;
    background: var(--surface); border: 1px solid var(--rule);
    font-family: var(--display); font-weight: 700; color: var(--muted);
  }
  .result { display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: center; }
  .flags { display: inline-flex; gap: 4px; flex-wrap: wrap; }
  .version { overflow-wrap: anywhere; }
  .empty { padding: 40px 0; display: grid; gap: 16px; justify-items: start; }
  .empty[hidden] { display: none; }

  @media (max-width: 760px) {
