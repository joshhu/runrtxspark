---
import { waferLayout } from '../lib/wafer.mjs';
import { getDict } from '../lib/i18n.mjs';

const { apps, locale } = Astro.props;
const t = getDict(locale);
const base = import.meta.env.BASE_URL;
const { size, center, radius, dies } = waferLayout(apps);
---
<figure class="wafer">
  <div class="disc">
    <svg viewBox={`0 0 ${size} ${size}`} role="group" aria-label={t.hero.waferCaption}>
      <circle cx={center} cy={center} r={radius} class="edge" />
      {dies.map((die) =>
        die.app ? (
          <a href={`${base}${locale}/apps/${die.app.id}/`} data-wafer-die={die.app.id} aria-label={`${die.app.name}: ${t.status[die.app.status]}`}>
            <title>{`${die.app.name}: ${t.status[die.app.status]}`}</title>
            <rect x={die.x} y={die.y} width={die.w} height={die.w} rx="1.5" class={`die die-${die.app.status}`} style={`--d:${die.delay}`} />
          </a>
        ) : (
          <rect x={die.x} y={die.y} width={die.w} height={die.w} rx="1.5" class="die die-empty" style={`--d:${die.delay}`} />
        ),
      )}
      <path d={`M${center - 9} ${size - 6} a9 9 0 0 1 18 0 z`} class="notch" />
    </svg>
  </div>
  <figcaption class="muted small">{t.hero.waferCaption}</figcaption>
</figure>

<style>
  .wafer { margin: 0; }
  .disc {
    border-radius: 50%;
    aspect-ratio: 1;
    background:
      conic-gradient(from 210deg, var(--wafer-a), var(--wafer-b), var(--wafer-c), var(--wafer-a), var(--wafer-b), var(--wafer-a));
  }
  svg { display: block; width: 100%; height: auto; }
  .edge { fill: none; stroke: var(--rule); stroke-width: 1; }
  .notch { fill: var(--bg); }
  .die { transition: opacity 120ms; animation: probe 380ms ease-out both; animation-delay: calc(var(--d) * 520ms); }
  .die-native { fill: var(--die-native); }
  .die-prism { fill: var(--die-prism); }
  .die-broken { fill: var(--die-broken); }
  .die-empty { fill: var(--die-empty); opacity: 0.55; animation-name: none; }
  a:hover .die, a:focus-visible .die { fill: var(--ink); }
  a:focus-visible { outline: none; }
  a:focus-visible .die { stroke: var(--accent); stroke-width: 3; }
  figcaption { margin-top: 12px; max-width: 42ch; }
  @keyframes probe {
    from { opacity: 0.12; }
    to { opacity: 1; }
  }
  /* Dies marked by the search script. Everything else dims so matches stand out. */
  :global(.wafer-filtered) a:not(.is-match) .die { opacity: 0.18; }
</style>
