---
// Shape carries the status as well as color, for color-blind readers and for print.
const { status } = Astro.props;
---
<svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
  {status === 'native' && <circle cx="8" cy="8" r="7" />}
  {status === 'prism' && (
    <>
      <circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.6" />
      <path d="M8 1.8a6.2 6.2 0 0 1 0 12.4z" />
    </>
  )}
  {status === 'broken' && <path d="M2.2 4.1 4.1 2.2 8 6.1l3.9-3.9 1.9 1.9L9.9 8l3.9 3.9-1.9 1.9L8 9.9l-3.9 3.9-1.9-1.9L6.1 8z" />}
</svg>
