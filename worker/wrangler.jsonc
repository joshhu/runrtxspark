{
  "name": "runrtxspark-report",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://josh.hu",
    "GITHUB_REPO": "joshhu/runrtxspark"
  },
  // Secrets, set with `wrangler secret put`: GITHUB_TOKEN, TURNSTILE_SECRET
  "ratelimits": [
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
